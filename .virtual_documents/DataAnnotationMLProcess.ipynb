import pandas as pd
import numpy as np

# Set display options to show more rows and columns
pd.set_option('display.max_rows', 20)
pd.set_option('display.max_columns', 100)
pd.set_option('display.width', 1000)
pd.set_option('display.expand_frame_repr', False)
pd.set_option('display.max_colwidth', 100)

# Load the file using the exact filename provided
filename = 'fanduel_model_evaluation_2025.xlsx'  # Use the actual filename
# Determine file type and load appropriately
if filename.endswith('.csv'): 
    df = pd.read_csv(filename) 
elif filename.endswith(('.xlsx', '.xls')): 
    df = pd.read_excel(filename) 
elif filename.endswith('.json'): 
    df = pd.read_json(filename) 
elif filename.endswith('.txt'): 
    df = pd.read_csv(filename, sep=None, engine='python') 
else: 
    print(f"File type not recognized. Attempting to load as CSV.") 
    df = pd.read_csv(filename)

# Basic data inspection
print("=== DATA OVERVIEW ===") 
print(f"Rows: {df.shape[0]}, Columns: {df.shape[1]}") 
print("\nFirst 10 rows:") 
print(df.head(10))

print("\nLast 5 rows:")
print(df.tail(5))

print("\nColumn names:") 
print(df.columns.tolist())

print("\nData types:") 
print(df.dtypes)

print("\nMissing values:") 
print(df.isnull().sum())

print("\nSummary statistics:") 
print(df.describe(include='all').transpose())

# Check for duplicates
print(f"\nDuplicate rows: {df.duplicated().sum()}")

# Sample data from throughout the dataset
print("\nRandom sample of 5 rows:")
print(df.sample(5))

# Identify relevant columns based on the user's specific question
# Examine data distributions relevant to the user's request
# For predicting if a player hits their line, look for potential target (e.g., binary outcome) and feature columns (e.g., player stats, lines)
potential_target = [col for col in df.columns if 'hit' in col.lower() or 'outcome' in col.lower() or 'result' in col.lower() or 'over_under' in col.lower()]
potential_features = [col for col in df.columns if 'stat' in col.lower() or 'line' in col.lower() or 'player' in col.lower() or col.lower() in ['age', 'team', 'opponent', 'points', 'rebounds', 'assists']]
print("\nPotential target columns for prediction (e.g., hit/miss):", potential_target)
print("Potential feature columns (e.g., player stats, lines):", potential_features)

# If numeric columns exist, show basic distributions for relevant ones
if potential_features:
    print("\nDistributions for potential numeric features:")
    print(df[potential_features].describe())


# 1. Drop redundant duplicate columns
redundant_cols = [c for c in df.columns if ':1' in c and c.replace(':1','') in df.columns]
df_clean = df.drop(columns=redundant_cols)

# 2. (Optional) keep only 'Over' outcomes if modeling Over vs. Under
df_over = df_clean[df_clean['outcome_name']=='Over'].copy()

# 3. Define binary target
df_over['target'] = df_over['line_result']

# 4. Convert dates and sort
df_over['GAME_DATE_EST'] = pd.to_datetime(df_over['GAME_DATE_EST'])
df_over = df_over.sort_values(['PLAYER_ID','GAME_DATE_EST'])

# 5. Stats to transform into leakage-safe rolling features (using transform on df_over)
# Define stats to roll
stats = [
    'PTS','AST','REB','FGM','FGA','FG3M','FG3A',
    'FTM','FTA','STL','BLK','TO','OREB','DREB','POSS'
]

# Compute 5‐game rolling averages using only prior games 
#    (shift before rolling, then align with reset_index)
for stat in stats:
    rolled = (
        df_over
        .groupby('PLAYER_ID')[stat]
        .apply(lambda x: x.shift().rolling(window=5, min_periods=1).mean())
        .reset_index(level=0, drop=True)
    )
    df_over[f'rolling5_{stat}'] = rolled

# Explicitly set the very first game of each player to NaN
first_idxs = df_over.groupby('PLAYER_ID').head(1).index
rolling_cols = [f'rolling5_{s}' for s in stats]
df_over.loc[first_idxs, rolling_cols] = np.nan

# 6. Now df_over includes rolling5_* columns and you can select them:
base = [
    'PLAYER_ID','TEAM_ID','HOME_TEAM_ID','VISITOR_TEAM_ID',
    'Predicted_PTS','point','american_odds','decimal_odds','Season',
    'HOME_TEAM','AWAY_TEAM','description','GAME_DATE_EST'
]
rolling_feats = [f'rolling5_{s}' for s in stats]
meta = ['target','GAME_ID','event_id']
df_ml = df_over[ base + rolling_feats + meta ].drop_duplicates()

# 7. Encode categoricals & add is_home flag
for col in ['PLAYER_ID','HOME_TEAM','AWAY_TEAM']:
    df_ml[col] = df_ml[col].astype('category')
df_ml['is_home'] = (df_ml['TEAM_ID']==df_ml['HOME_TEAM_ID']).astype(int)

# 8. Drop any rows missing rolling features or target
df_ml = df_ml.dropna(subset=rolling_feats+['target'])
df_ml.to_csv('output.csv')

# 9. Summary
print("=== CLEANED DATA OVERVIEW ===")
print(f"Rows: {df_ml.shape[0]}, Columns: {df_ml.shape[1]}")
print("\nColumns:", df_ml.columns.tolist())
print("\nMissing values:\n", df_ml.isnull().sum())
print("\nTarget distribution:\n", df_ml['target'].value_counts(normalize=True))
print("\nSample rows:\n", df_ml.sample(5))
print("\nRolling stats summary:\n", df_ml[rolling_feats].describe())


import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, roc_auc_score, classification_report
from sklearn.impute import SimpleImputer

# Assuming df_ml is available from previous step

# 1. Select features and target
numerical_features = [
    'Predicted_PTS', 'point', 'american_odds', 'decimal_odds', 'Season',
    'rolling5_PTS', 'rolling5_AST', 'rolling5_REB', 'rolling5_FGM', 'rolling5_FGA',
    'rolling5_FG3M', 'rolling5_FG3A', 'rolling5_FTM', 'rolling5_FTA', 'rolling5_STL',
    'rolling5_BLK', 'rolling5_TO', 'rolling5_OREB', 'rolling5_DREB', 'rolling5_POSS', 'is_home'
]
categorical_features = ['HOME_TEAM', 'AWAY_TEAM']  # PLAYER_ID might be too high-cardinality; exclude or handle separately if needed
X = df_ml[numerical_features + categorical_features]
y = df_ml['target']

# 2. Temporal split to prevent leakage (e.g., train on earlier dates, test on later)
df_ml_sorted = df_ml.sort_values('GAME_DATE_EST')
split_date = df_ml_sorted['GAME_DATE_EST'].quantile(0.8)  # Use 80% earliest for train
train_mask = df_ml_sorted['GAME_DATE_EST'] <= split_date
test_mask = df_ml_sorted['GAME_DATE_EST'] > split_date
X_train = X[train_mask]
y_train = y[train_mask]
X_test = X[test_mask]
y_test = y[test_mask]

# 3. Preprocessing pipeline
numerical_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='mean')),
    ('scaler', StandardScaler())
])
categorical_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='constant', fill_value='missing')),
    ('onehot', OneHotEncoder(handle_unknown='ignore', sparse_output=False))
])
preprocessor = ColumnTransformer(
    transformers=[
        ('num', numerical_transformer, numerical_features),
        ('cat', categorical_transformer, categorical_features)
    ])

# 4. Create and train the model pipeline
model = Pipeline(steps=[
    ('preprocessor', preprocessor),
    ('classifier', RandomForestClassifier(random_state=42, n_estimators=100))
])
model.fit(X_train, y_train)

# 5. Predict and evaluate
y_pred = model.predict(X_test)
y_pred_proba = model.predict_proba(X_test)[:, 1]
accuracy = accuracy_score(y_test, y_pred)
precision = precision_score(y_test, y_pred)
recall = recall_score(y_test, y_pred)
roc_auc = roc_auc_score(y_test, y_pred_proba)

# Extract feature importances (accounting for one-hot encoding)
feature_names = (numerical_features + 
                 model.named_steps['preprocessor'].named_transformers_['cat']
                 .named_steps['onehot'].get_feature_names_out(categorical_features).tolist())
importances = model.named_steps['classifier'].feature_importances_
feature_importance = pd.DataFrame({'feature': feature_names, 'importance': importances}).sort_values('importance', ascending=False)

# 6. Output results
print("=== MODEL EVALUATION ===")
print(f"Test Set Size: {len(y_test)}")
print(f"Accuracy: {accuracy:.4f}")
print(f"Precision: {precision:.4f}")
print(f"Recall: {recall:.4f}")
print(f"ROC AUC: {roc_auc:.4f}")
print("\nClassification Report:\n", classification_report(y_test, y_pred))
print("\nTop 10 Feature Importances:\n", feature_importance.head(10))


import pandas as pd
import numpy as np
from sklearn.model_selection import GridSearchCV, StratifiedKFold, cross_validate
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.metrics import accuracy_score, precision_score, recall_score, roc_auc_score, classification_report
from xgboost import XGBClassifier
import warnings
warnings.filterwarnings('ignore')

# 1. Feature engineering
df_ml['pts_vs_line']       = df_ml['rolling5_PTS']   - df_ml['point']
df_ml['ast_vs_expected']   = df_ml['rolling5_AST']   / (df_ml['point'] + 1)
df_ml['reb_vs_expected']   = df_ml['rolling5_REB']   / (df_ml['point'] + 1)
df_ml['fg_efficiency']     = df_ml['rolling5_FGM']   / (df_ml['rolling5_FGA'] + 1)
df_ml['turnover_rate']     = df_ml['rolling5_TO']    / (df_ml['rolling5_POSS'] + 1)

# 2. Define feature lists
numerical_features = [
    'Predicted_PTS','point','american_odds','decimal_odds','Season',
    'rolling5_PTS','rolling5_AST','rolling5_REB','rolling5_FGM','rolling5_FGA',
    'rolling5_FG3M','rolling5_FG3A','rolling5_FTM','rolling5_FTA','rolling5_STL',
    'rolling5_BLK','rolling5_TO','rolling5_OREB','rolling5_DREB','rolling5_POSS',
    'is_home','pts_vs_line','ast_vs_expected','reb_vs_expected','fg_efficiency','turnover_rate'
]
categorical_features = ['HOME_TEAM','AWAY_TEAM']

X = df_ml[numerical_features + categorical_features]
y = df_ml['target']

# 3. Temporal train/test split (80/20 by date)
df_sorted = df_ml.sort_values('GAME_DATE_EST')
split_date = df_sorted['GAME_DATE_EST'].quantile(0.8)
train_mask = df_sorted['GAME_DATE_EST'] <= split_date
test_mask  = df_sorted['GAME_DATE_EST'] >  split_date

X_train, X_test = X[train_mask], X[test_mask]
y_train, y_test = y[train_mask], y[test_mask]

# 4. Preprocessing pipelines
num_pipe = Pipeline([
    ('imputer', SimpleImputer(strategy='mean')),
    ('scaler',  StandardScaler())
])
cat_pipe = Pipeline([
    ('imputer', SimpleImputer(strategy='constant', fill_value='missing')),
    ('onehot',  OneHotEncoder(handle_unknown='ignore', sparse_output=False))
])
preprocessor = ColumnTransformer([
    ('num', num_pipe, numerical_features),
    ('cat', cat_pipe, categorical_features)
])

# 5. XGBoost pipeline + hyperparameter tuning
xgb_pipe = Pipeline([
    ('preprocessor', preprocessor),
    ('classifier', XGBClassifier(random_state=42, eval_metric='logloss'))
])
param_grid = {
    'classifier__n_estimators':    [50, 100, 150],
    'classifier__max_depth':       [3, 5, 7],
    'classifier__learning_rate':   [0.01, 0.1, 0.3],
    'classifier__subsample':       [0.7, 0.9]
}
grid_search = GridSearchCV(
    xgb_pipe, param_grid,
    cv=3, scoring='roc_auc', n_jobs=-1
)
grid_search.fit(X_train, y_train)
best_model = grid_search.best_estimator_
print("Best parameters:", grid_search.best_params_)

# 6. Evaluate on test set
y_pred       = best_model.predict(X_test)
y_pred_prob  = best_model.predict_proba(X_test)[:,1]
print("\n=== Test Set Evaluation ===")
print("Accuracy :", accuracy_score(y_test, y_pred))
print("Precision:", precision_score(y_test, y_pred))
print("Recall   :", recall_score(y_test, y_pred))
print("ROC AUC  :", roc_auc_score(y_test, y_pred_prob))
print("\nClassification Report:\n", classification_report(y_test, y_pred))

# 7. Cross‐validation with best parameters
# Extract classifier params without the 'classifier__' prefix
best_params = {k.split('__')[1]: v for k,v in grid_search.best_params_.items()}
cv_pipeline = Pipeline([
    ('preprocessor', preprocessor),
    ('classifier', XGBClassifier(random_state=42, eval_metric='logloss', **best_params))
])
cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
scoring = ['accuracy','precision','recall','roc_auc']
cv_results = cross_validate(
    cv_pipeline, X, y,
    cv=cv,
    scoring=scoring,
    n_jobs=-1
)

print("\n=== Cross-Validation Results ===")
for metric in scoring:
    scores = cv_results[f'test_{metric}']
    print(f"{metric.capitalize():<10}: {scores.mean():.4f} ± {scores.std():.4f}")


